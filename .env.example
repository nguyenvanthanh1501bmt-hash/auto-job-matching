# Copy this file to .env and configure local environment variables.
# Do not commit the generated .env file.

# =========================
# AutoJob Java application
# =========================

AUTOJOB_APP_PORT=8080
SERVER_PORT=8080
MONGODB_AUTO_INDEX_CREATION=true

# =========================
# MongoDB
# =========================

MONGO_PORT=27018
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE=autojob

# =========================
# Qdrant
# =========================

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_BASE_URL=http://localhost:6333
QDRANT_JOB_COLLECTION=job_vectors_v1
QDRANT_VECTOR_DIMENSION=384
QDRANT_DISTANCE=Cosine

# =========================
# Embedding service
# =========================

EMBEDDING_SERVICE_PORT=8002
EMBEDDING_SERVICE_BASE_URL=http://localhost:8002
EMBEDDING_PROVIDER=sentence-transformer
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=c007d7ef6fd86656326059b28395a7a03a7c5846
EMBEDDING_EXPECTED_DIMENSION=384
EMBEDDING_PREPROCESSING_VERSION=prep-v1
EMBEDDING_NORMALIZATION_STRATEGY=l2
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_TEXT_CHARS=20000
EMBEDDING_LOAD_ON_STARTUP=true
EMBEDDING_LOG_LEVEL=INFO
EMBEDDING_EXPECTED_VERSION=intfloat/multilingual-e5-small@c007d7ef6fd86656326059b28395a7a03a7c5846|prep-v1|l2

EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_RESPONSE_TIMEOUT=30s
EMBEDDING_MAX_ERROR_LENGTH=1000

# =========================
# MinIO
# =========================

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_CVS=autojob-cvs

# =========================
# CV parser Java client
# =========================

CV_PARSER_SERVICE_PORT=8003
CV_PARSER_BASE_URL=http://localhost:8003
CV_PARSER_CONNECT_TIMEOUT=3s
CV_PARSER_RESPONSE_TIMEOUT=60s
CV_PARSER_EXPECTED_VERSION=rule-v1
CV_PARSER_MAX_ERROR_LENGTH=1000
CV_PARSER_MAX_RESPONSE_SIZE_BYTES=16777216

# =========================
# CV parser Python service
# =========================

CV_PARSER_APP_NAME=autojob-cv-parser-service
CV_PARSER_VERSION=rule-v1
CV_PARSER_LOG_LEVEL=INFO

CV_MAX_OBJECT_SIZE_BYTES=10485760
CV_MAX_EXTRACTED_CHARS=200000
CV_MAX_SECTION_CHARS=50000

CV_MAX_WORK_EXPERIENCES=30
CV_MAX_PROJECTS=30
CV_MAX_EDUCATIONS=20
CV_MAX_CERTIFICATIONS=30
CV_MAX_LICENSES=20
CV_MAX_TRAINING_COURSES=30
CV_MAX_SKILLS=200
CV_MAX_LINKS=30

CV_MAX_DOCX_ENTRIES=1000
CV_MAX_DOCX_UNCOMPRESSED_BYTES=52428800

CV_DOC_COMMAND_TIMEOUT_SECONDS=20
CV_EXTRACTION_TIMEOUT_SECONDS=45
CV_MIN_TEXT_CHARACTERS=40
CV_MAX_PDF_PAGES=100

# Pydantic collection fields require a JSON array.
CV_ALLOWED_OBJECT_PREFIXES=["raw/","cvs/"]

# =========================
# CV upload
# =========================

CV_PUBLIC_OWNER_USER_ID=public-local-user

CV_MAX_FILE_SIZE_MB=10
CV_MAX_FILE_SIZE=10MB
CV_MAX_REQUEST_SIZE=11MB

# =========================
# Mock job site
# =========================

MOCK_JOB_SITE_PORT=18080

# =========================
# Authentication
# =========================

AUTH_PUBLIC_API_MODE=true
AUTH_JWT_ISSUER=autojob-app

# Local development only.
# Production: openssl rand -base64 48
JWT_SECRET_BASE64=YXV0b2pvYi1sb2NhbC1kZXYtc2VjcmV0LWNoYW5nZS1tZS0zMmJ5dGVzLXBsdXMhIQ==

AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

FRONTEND_ORIGIN=http://localhost:5173

# =========================
# Rate limit
# =========================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false

RATE_LIMIT_GENERAL_CAPACITY=120
RATE_LIMIT_GENERAL_PERIOD=1m

RATE_LIMIT_LOGIN_CAPACITY=10
RATE_LIMIT_LOGIN_PERIOD=1m

RATE_LIMIT_REGISTER_CAPACITY=5
RATE_LIMIT_REGISTER_PERIOD=1h

RATE_LIMIT_REFRESH_CAPACITY=30
RATE_LIMIT_REFRESH_PERIOD=1m

RATE_LIMIT_CV_UPLOAD_CAPACITY=10
RATE_LIMIT_CV_UPLOAD_PERIOD=1h