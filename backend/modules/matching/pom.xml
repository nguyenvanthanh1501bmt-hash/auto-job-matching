<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.autojob</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>matching</artifactId>

  <dependencies>
    <!--
        Matching đọc candidate profile để lấy structured features
        như skills, seniority, preferred locations...
    -->
    <dependency>
      <groupId>com.autojob</groupId>
      <artifactId>cv</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
        Matching dùng candidate embedding đã sinh sẵn,
        không tự gọi embedding model lại.
    -->
    <dependency>
      <groupId>com.autojob</groupId>
      <artifactId>candidate-embedding</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
        Matching đọc normalized job để rule-based reranking.
    -->
    <dependency>
      <groupId>com.autojob</groupId>
      <artifactId>job-normalizer</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
        Matching sẽ gọi abstraction search vector của job-embedding.
    -->
    <dependency>
      <groupId>com.autojob</groupId>
      <artifactId>job-embedding</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>